# upall: lets one user run upall's root helper without a password, so updates can run unattended.
# install.sh replaces @USER@ with your user name, checks the result with visudo and prints the commands that
# install it as /etc/sudoers.d/upall-nopasswd (mode 0440, root:root). See README.md, "The sudoers rule".
#
# Only /usr/local/sbin/upall-root is allowed: a root-owned script that accepts a fixed list of actions (refresh
# the apt lists, upgrade, snap refresh, create/prune upall's own Timeshift and /home snapshots) and no free-form
# options, paths or environment. Nothing here allows running apt, nala, snap, timeshift or btrfs directly.
# sudo resets the environment (env_reset); the helper sets PATH, LC_ALL and DEBIAN_FRONTEND itself.
@USER@ ALL=(root) NOPASSWD: /usr/local/sbin/upall-root
