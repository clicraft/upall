#!/usr/bin/env bash
# upall: check or update every package source on this machine.
#
#   upall check        list what is outdated (read-only, no password, sources queried in parallel)
#   upall              update: apt (nala) + Flatpak + Snap in parallel, then topgrade for the rest
#   upall --system     only the apt/Flatpak/Snap group
#   upall --firmware   also apply firmware updates (fwupd) at the end
#   upall --tui        same update, shown as a live table (speed, sizes, current package per source)
#   upall --tui --demo preview the live table with fake jobs (changes nothing)
#   upall --ask        always show the apt plan and ask before running it
#   upall --security   only apt's security updates (what upall-secwatch runs unattended); no Flatpak/Snap/tools
#
# Safety: before apt, the plan is simulated. It asks (y/N) only when the plan removes packages or brings a
# kernel that /boot may not hold; nothing to ask = nobody asked. A Timeshift snapshot is taken before apt
# (last 2 kept), and a read-only btrfs snapshot of /home before topgrade (user-level tools; last 2, max 14 days).
# At the end PackageKit refreshes, so Discover and its tray icon see the new state.
#
# Logs: ~/.local/state/upall/<date-time>/<source>.log
# Docs: https://github.com/clicraft/upall
set -uo pipefail

LOGROOT="${XDG_STATE_HOME:-$HOME/.local/state}/upall"
# Every root command goes through upall-root, which accepts fixed actions only (see sbin/upall-root).
# Passwordless: the root-owned copy in /usr/local/sbin, allowed by /etc/sudoers.d/upall-nopasswd.
# Without it: the copy installed with upall, run through sudo with your password.
ROOT_SYS=/usr/local/sbin/upall-root
ROOT_LOCAL="$HOME/.local/lib/upall/upall-root"
ROOT=$ROOT_SYS

# Colours only on a terminal that has them; the spinner only on a terminal at all.
TTY=0; [[ -t 1 ]] && TTY=1
if ((TTY)) && (( $(tput colors 2>/dev/null || echo 0) >= 8 )); then
    B=$'\e[1m'; G=$'\e[32m'; R=$'\e[31m'; Y=$'\e[33m'; D=$'\e[2m'; N=$'\e[0m'; SP=$'\e[1;36m'
else B=; G=; R=; Y=; D=; N=; SP=; fi
FRAMES=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)

say()  { printf '%s\n' "$*"; }
head_() { printf '\n%s== %s ==%s\n' "$B" "$*" "$N"; }
have() { command -v "$1" >/dev/null 2>&1; }
fmt_t() { printf '%dm%02ds' $(($1 / 60)) $(($1 % 60)); }

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; }

# ---------------------------------------------------------------- spinner
# Download speed for the spinner line: the whole machine's receive rate, from the interface counters in
# /proc/net/dev (all interfaces except lo), in IEC units. Shown right-aligned only when the line has room.
net_rx() { awk 'NR > 2 { sub(/:/, " "); if ($1 != "lo") s += $2 } END { printf "%d", s }' /proc/net/dev; }
fmt_rate() {
    LC_ALL=C awk -v b="$1" 'BEGIN { split("B KiB MiB GiB TiB", u, " "); i = 1
        while (b >= 1024 && i < 5) { b /= 1024; i++ }
        printf (i <= 2 ? "%.0f %s/s" : "%.1f %s/s"), b, u[i] }'
}
now_us() { local t=${EPOCHREALTIME/[.,]/}; echo "${t}"; }   # µs; the decimal sign depends on the locale
RX_T=0 RX_LAST=0 RATE_TXT='' COLS=80
spin_reset() { RX_T=0; RATE_TXT=''; COLS=$(tput cols 2>/dev/null || echo 80); }

# spin_frame MSG START: one frame on the current line (braille wheel, message, elapsed, speed if room).
SPIN_I=0
spin_frame() {
    local now rx left right pad
    now=$(now_us)
    if ((now - RX_T >= 500000)); then             # re-measure twice a second
        rx=$(net_rx)
        ((RX_T)) && RATE_TXT=$(fmt_rate $(( (rx - RX_LAST) * 1000000 / (now - RX_T) )))
        RX_LAST=$rx RX_T=$now
        COLS=$(tput cols 2>/dev/null || echo 80)
    fi
    left="${FRAMES[SPIN_I++ % ${#FRAMES[@]}]} $1 $(fmt_t $((SECONDS - $2)))"
    right=${RATE_TXT:+↓ $RATE_TXT}
    pad=$((COLS - ${#left} - ${#right} - 1))
    if [[ -n $right ]] && ((pad >= 2)); then
        printf '\r%s%s%s %s %s%s%s%*s%s%s%s\e[K' "$SP" "${left:0:1}" "$N" "$1" "$D" "$(fmt_t $((SECONDS - $2)))" "$N" \
            "$pad" "" "$SP" "$right" "$N"
    else
        printf '\r%s%s%s %s %s%s%s\e[K' "$SP" "${left:0:1}" "$N" "$1" "$D" "$(fmt_t $((SECONDS - $2)))" "$N"
    fi
}
spin_clear() { ((TTY)) && printf '\r\e[K'; }
# spin MSG LOG CMD...: run CMD (output to LOG) with a spinner; returns CMD's exit code.
# CMD runs in a subshell: its PID is ours even when CMD is sudo (kill -0 on a root PID fails).
spin() {
    local msg=$1 log=$2 start=$SECONDS pid rc; shift 2
    ( "$@" ) >"$log" 2>&1 </dev/null &
    pid=$!
    if ((TTY)); then
        spin_reset; tput civis 2>/dev/null
        while kill -0 "$pid" 2>/dev/null; do spin_frame "$msg" "$start"; sleep 0.1; done
        spin_clear; tput cnorm 2>/dev/null
    fi
    wait "$pid"; rc=$?
    SPIN_T=$((SECONDS - start))
    return $rc
}

# ---------------------------------------------------------------- check mode
check_apt() {
    sudo -n "$ROOT_SYS" update-quiet >/dev/null 2>&1 \
        || say "(apt lists not refreshed: apt lock busy or upall-root not passwordless; showing cached state)"
    # ⚠ marks updates from a *-security pocket (Ubuntu security fixes)
    LC_ALL=C apt list --upgradable 2>/dev/null | tail -n +2 \
        | awk -F'[/ ]' '{v=$3; o=$0; sub(/.*upgradable from: /,"",o); sub(/\]$/,"",o)
                         m=($2 ~ /-security/) ? "⚠ " : "  "; printf "%s%-43s %s -> %s\n",m,$1,o,v}'
}
check_flatpak() {
    LC_ALL=C flatpak remote-ls --updates --columns=application,version,branch 2>/dev/null \
        | awk -F'\t' 'NF{printf "%-45s %s (%s)\n",$1,($2==""?"-":$2),$3}'
}
check_snap() {
    LC_ALL=C snap refresh --list 2>&1 | awk 'NR>1 && NF{printf "%-45s -> %s\n",$1,$2}'
}
check_firmware() {
    # exit 2 = nothing to do; uses the metadata fwupd-refresh.timer already downloaded
    LC_ALL=C fwupdmgr get-updates --no-unreported-check --no-metadata-check --json 2>/dev/null \
        | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit()
for dev in d.get("Devices", []):
    for r in dev.get("Releases", []):
        print("%-45s %s -> %s" % (dev.get("Name", "?"), dev.get("Version", "?"), r.get("Version", "?")))
'
}
check_rustup() {
    LC_ALL=C rustup check 2>/dev/null | grep -i 'update available' \
        | sed -E 's/ - [Uu]pdate available ?: / /; s/ \([0-9a-f]+ [0-9-]+\)//g' | awk '{printf "%-45s %s %s %s\n",$1,$2,$3,$4}'
}
check_npm() {
    # --parseable: dir:wanted:current:latest  (each as name@version)
    npm outdated -g --parseable 2>/dev/null | while IFS=: read -r _ _ current latest _; do
        name=${latest%@*}; printf '%-45s %s -> %s\n' "$name" "${current##*@}" "${latest##*@}"
    done
}

# AutoFirma has no apt repository: it is a .deb downloaded by hand from the Spanish government's page, so apt
# never reports it. The page links the Linux zips, whose NAME carries the version (autofirma_1_9.deb), and
# a zip keeps its file list at the END, so a 64 KB range request reads it without the 67 MB download.
# Read-only. If the page or the zip cannot be read it says so (a line starting "(" is a note, not an update),
# because "could not check" must never print as "up to date".
check_autofirma() {
    local installed; installed=$(dpkg-query -W -f='${Version}' autofirma 2>/dev/null) || return 0
    [[ -n $installed ]] || return 0
    AFIRMA_INSTALLED=$installed python3 -I -c '
import os, re, struct, sys, urllib.request
BASE = "https://firmaelectronica.gob.es"
PAGE = BASE + "/ciudadanos/descargas.html"
def get(url, headers=None, method="GET"):
    req = urllib.request.Request(url, headers=headers or {}, method=method)
    return urllib.request.urlopen(req, timeout=15)
def key(v):  # "1.9.0" and "1.9" are the same version
    t = [int(x) for x in re.findall(r"\d+", v)]
    while t and t[-1] == 0:
        t.pop()
    return t
try:
    html = get(PAGE).read().decode("utf8", "replace")
    links = sorted(set(re.findall(r"href=\"([^\"]*Linux_Debian\.zip)\"", html, re.I)))
    if not links:
        raise RuntimeError("no Linux Debian download found on the page")
    best = None
    for link in links:
        url = link if link.startswith("http") else BASE + link
        size = int(get(url, method="HEAD").headers["Content-Length"])
        tail = get(url, {"Range": "bytes=%d-%d" % (max(0, size - 65536), size - 1)}).read()
        i = 0
        while True:
            i = tail.find(b"PK\x01\x02", i)
            if i < 0:
                break
            n = struct.unpack_from("<H", tail, i + 28)[0]
            name = tail[i + 46:i + 46 + n].decode("utf8", "replace")
            i += 46 + n
            m = re.search(r"(\d+(?:_\d+)*)\.deb$", name, re.I)
            if m:
                v = m.group(1).replace("_", ".")
                if best is None or key(v) > key(best[0]):
                    best = (v, url)
    if best is None:
        raise RuntimeError("no version in the zip file names")
    have = os.environ["AFIRMA_INSTALLED"]
    if key(best[0]) > key(have):
        print("%-45s %s -> %s  (manual .deb: %s)" % ("autofirma", have, best[0], PAGE))
except Exception as e:
    print("(autofirma: could not check the official page: %s)" % e)
'
}

do_check() {
    local tmp; tmp=$(mktemp -d); trap 'rm -rf "$tmp"' RETURN
    local src
    declare -A label=([apt]="apt (.deb)" [flatpak]="Flatpak" [snap]="Snap" [firmware]="Firmware (fwupd)"
                      [rustup]="Rust toolchain (rustup)" [npm]="npm global packages"
                      [autofirma]="AutoFirma (manual .deb)")
    local order=(apt flatpak snap firmware rustup npm autofirma)
    for src in "${order[@]}"; do
        case $src in
            flatpak) have flatpak || continue ;; snap) have snap || continue ;;
            firmware) have fwupdmgr || continue ;; rustup) have rustup || continue ;; npm) have npm || continue ;;
            autofirma) { have python3 && dpkg -s autofirma >/dev/null 2>&1; } || continue ;;
        esac
        ( "check_$src" >"$tmp/$src" 2>&1 ) &
    done
    local start=$SECONDS
    if ((TTY)); then
        spin_reset; tput civis 2>/dev/null
        while [[ -n $(jobs -rp) ]]; do spin_frame "Checking ${order[*]} in parallel…" "$start"; sleep 0.1; done
        spin_clear; tput cnorm 2>/dev/null
    fi
    wait
    say "${D}Checked in $(fmt_t $((SECONDS - start)))${N}"
    local total=0 n
    for src in "${order[@]}"; do
        [[ -f $tmp/$src ]] || continue
        n=$(grep -c . "$tmp/$src"; true)
        [[ $src == apt ]] && n=$(grep -vc '^(apt lists' "$tmp/$src"; true)
        if [[ $src == autofirma ]]; then
            if grep -q '^(' "$tmp/$src"; then  # a note, not an update: say it could not be checked
                printf '%s?%s %-26s %s\n' "$Y" "$N" "${label[$src]}" "$(sed -E 's/^\(autofirma: //; s/\)$//' "$tmp/$src")"
                continue
            fi
        fi
        total=$((total + n))
        if ((n == 0)); then printf '%s✔%s %-26s up to date\n' "$G" "$N" "${label[$src]}"
        else
            local sec=0; [[ $src == apt ]] && sec=$(grep -c '^⚠' "$tmp/$src"; true)
            head_ "${label[$src]}: $n$( ((sec)) && printf ' %s(%s security)%s' "$R" "$sec" "$N")"
            cat "$tmp/$src"
        fi
    done
    head_ "Not checked here"
    say "pipx, uv tools, cargo, VS Code extensions, editor plugins, gh extensions, Claude Code, Codex,"
    say "gcloud, SDKMAN, GHCup, Composer, Yazi… have no cheap read-only check; 'upall' updates them via topgrade."
    say "Total outdated in the sources above: $total"
}

# ---------------------------------------------------------------- safety checks before apt
KERNEL_MB=120        # one kernel + initramfs in /boot (~112 MB on Ubuntu 24.04); a 500 MB /boot holds two
SNAP_KEEP=2          # upall-pre-apt Timeshift snapshots kept: each one is deleted two updates later
APT_SKIP=0 APT_WORK=0 APT_PLAN=
SECURITY=0           # --security: apt's security updates only (upall-root plan-security / upgrade-security)

ask_yn() {  # ask_yn QUESTION: yes -> 0. Nobody at a terminal to answer = "no".
    local a
    ((TTY)) && [[ -r /dev/tty ]] || return 1
    read -r -p "$1 " a </dev/tty || return 1
    [[ $a == [yYsS]* ]]
}

# Packages nala's autoremove would take out after the upgrade: the same python-apt calls nala makes
# (full upgrade, then is_auto_removable). No root, nothing changed. Empty if python3-apt is missing.
auto_removals() {
    python3 -I -c '
import apt
c = apt.Cache()
c.upgrade(dist_upgrade=True)
print("\n".join(sorted(p.name for p in c if p.is_installed and not p.marked_delete and p.is_auto_removable)))
' 2>/dev/null
}

apt_safety() {  # $1 = 1: always show the plan and ask (--ask)
    local inst new remv auto=() kern boot_free nkern reasons=() r what=plan plan=$RUN/apt-plan.txt
    ((SECURITY)) && what="plan-security"
    # The plan comes from upall-root itself (no root needed) and its hash goes back with the upgrade: if the apt
    # lists change before apt runs (a refresh in between), upall-root refuses instead of running an unchecked plan.
    if ! "$ROOT" "$what" >"$plan" 2>"$RUN/apt-plan.err"; then
        say "${R}✘ apt simulation failed${N} ($(tail -n 1 "$RUN/apt-plan.err")): apt skipped"; APT_SKIP=1; return 0
    fi
    APT_PLAN=$(sha256sum <"$plan"); APT_PLAN=${APT_PLAN%% *}
    mapfile -t inst < <(awk '/^Inst /{print $2}' "$plan")
    mapfile -t new  < <(awk '/^Inst / && $3 !~ /^\[/{print $2}' "$plan")
    mapfile -t remv < <(awk '/^Remv /{print $2}' "$plan")
    # nala's autoremove; the security path doesn't autoremove. grep: no empty line = no phantom package.
    ((SECURITY)) || mapfile -t auto < <(auto_removals | grep .)
    mapfile -t kern < <(printf '%s\n' "${new[@]}" | grep -E '^linux-image-[0-9]')
    # nala removes the auto-removable packages even when nothing is upgraded: that counts as work (snapshot).
    APT_WORK=$(( ${#inst[@]} + ${#remv[@]} + ${#auto[@]} ))
    boot_free=$(df --output=avail -m /boot | tail -1 | tr -d ' ')
    nkern=$(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 'linux-image-[0-9]*' 2>/dev/null | grep -c '^ii ')
    say "${D}apt ${what/plan-security/security plan}: ${#inst[@]} to upgrade/install (${#new[@]} new), ${#remv[@]} to remove," \
        "${#auto[@]} to auto-remove${auto[*]:+ (${auto[*]})};" \
        "/boot ${boot_free} MB free, ${nkern} kernel(s) installed${N}"
    ((APT_WORK)) || return 0
    # Auto-removals (packages nothing needs any more, mostly old kernels) are expected: shown, not a reason to ask.
    ((${#remv[@]})) && reasons+=("the upgrade REMOVES ${#remv[@]} package(s): ${remv[*]}")
    if ((${#kern[@]})); then
        ((nkern >= 2)) && reasons+=("new kernel ${kern[*]} while ${nkern} are installed (/boot holds two)")
        ((boot_free < KERNEL_MB * ${#kern[@]} + 30)) &&
            reasons+=("new kernel needs ~$((KERNEL_MB * ${#kern[@]})) MB, /boot has ${boot_free} MB")
    fi
    ((${#reasons[@]} || $1)) || return 0
    for r in "${reasons[@]}"; do say "${Y}! ${r}${N}"; done
    if ((${#inst[@]})); then
        say "${D}packages:${N}"; printf '%s\n' "${inst[@]}" | paste -sd' ' | fold -s -w 100 | sed 's/^/    /'
    fi
    if ask_yn "${B}Run the apt upgrade?${N} [y/N]"; then return 0; fi
    APT_SKIP=1; say "${Y}apt skipped${N} (Flatpak, Snap and tools still run)"
}

pre_apt_snapshot() {  # Timeshift snapshot of / right before apt; keeps the newest $SNAP_KEEP of ours
    ((APT_WORK && !APT_SKIP)) || return 0
    local name s msg
    if ! have timeshift; then   # other machines: no snapshot tool here, don't block on it
        say "${D}no Timeshift on this system: apt runs without a snapshot${N}"; return 0
    fi
    if spin "Timeshift snapshot before apt…" "$RUN/snapshot.log" sudo -n "$ROOT" ts-create; then
        name=$(grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}' "$RUN/snapshot.log" | tail -1)
        say "${G}✔${N} snapshot ${B}${name}${N} ${D}(roll back: Timeshift, or sudo timeshift --restore --snapshot ${name})${N}"
        # upall-root deletes only snapshots whose comment is exactly upall-pre-apt, never the others
        while read -r s; do say "${D}  pruned old snapshot $s${N}"; done < <(sudo -n "$ROOT" ts-prune "$SNAP_KEEP" 2>/dev/null)
    else
        if grep -qiE 'password is required|contrasenya|a terminal is required' "$RUN/snapshot.log"; then
            msg="upall-root isn't passwordless yet (see 'The sudoers rule' in the README)"
        else msg=$(tail -n 1 "$RUN/snapshot.log"); fi
        say "${Y}! no snapshot: ${msg}${N}"
        ask_yn "${B}Run apt without a snapshot?${N} [y/N]" || { APT_SKIP=1; say "${Y}apt skipped${N}"; }
    fi
}

# Read-only btrfs snapshot of /home right before topgrade: the user-level tools it updates (rustup, pipx, uv,
# npm, VS Code extensions…) all live in home folders, which Timeshift doesn't cover. Restore ONE tool by copying
# its folder back (README, "Restoring one tool"); never roll back all of /home. Kept: newest $TOOLS_KEEP, none
# older than $TOOLS_MAX_DAYS (@home churns: downloads, caches and deleted files stay pinned by a snapshot).
# upall-root makes the snapshot in /home/.snapshots (root-owned, created on first use) and prunes only its own.
TOOLS_KEEP=2
TOOLS_MAX_DAYS=14

pre_tools_snapshot() {
    [[ $(stat -f -c %T /home 2>/dev/null) == btrfs && $(stat -c %i /home 2>/dev/null) == 256 ]] || {
        say "${D}/home is not a btrfs subvolume: topgrade runs without a snapshot${N}"; return 0; }
    local name msg s
    if name=$(sudo -n "$ROOT" home-snapshot 2>"$RUN/home-snapshot.log"); then
        say "${G}✔${N} /home snapshot ${B}${name##*/}${N} ${D}(restore one tool: see 'Restoring one tool' in the README)${N}"
        while read -r s; do say "${D}  pruned old /home snapshot $s${N}"; done \
            < <(sudo -n "$ROOT" home-prune "$TOOLS_KEEP" "$TOOLS_MAX_DAYS" 2>/dev/null)
    else
        if grep -qiE 'password is required|contrasenya|a terminal is required' "$RUN/home-snapshot.log"; then
            msg="upall-root isn't passwordless yet (see 'The sudoers rule' in the README)"
        else msg=$(tail -n 1 "$RUN/home-snapshot.log"); fi
        # Tool updates are recoverable one by one (reinstall a version), so warn and go on instead of stopping.
        say "${Y}! no /home snapshot: ${msg}; topgrade runs anyway${N}"
    fi
}

pk_refresh() {  # PackageKit cache refresh: Discover and its tray notifier rebuild their update lists
    have python3 && [[ -f $PK ]] || return 0
    local rc=0 why
    spin "Refreshing Discover's package cache (PackageKit)…" "$RUN/packagekit.log" python3 -I "$PK" || rc=$?
    why=$(tail -n 1 "$RUN/packagekit.log" | cut -c1-200)
    case $rc in
        0) say "${G}✔${N} Discover / PackageKit refreshed ${D}in $(fmt_t "$SPIN_T")${N}" ;;
        # A dead PPA/repo host: apt already skipped it, PackageKit fails the whole refresh. Retrying now won't help.
        3) say "${Y}! Discover cache not fully refreshed: ${why#PackageKit refresh: }${N}"
           say "  ${D}apt skipped them and the upgrade is unaffected; Discover's list may lack their updates until they are back (details: $RUN/packagekit.log)${N}" ;;
        *) say "${Y}! ${why:-PackageKit refresh failed}; press 'Actualitza la llista' in Discover (details: $RUN/packagekit.log)${N}" ;;
    esac
}

# ---------------------------------------------------------------- update mode
SUDO_KEEPALIVE=
cleanup() { [[ -n $SUDO_KEEPALIVE ]] && kill "$SUDO_KEEPALIVE" 2>/dev/null; ((TTY)) && tput cnorm 2>/dev/null; }
trap cleanup EXIT
trap 'say ""; say "${Y}Ctrl-C: running package jobs are left to finish (interrupting dpkg is unsafe). Logs: ${RUN:-none}${N}"' INT

run_job() {  # name, command... ; output goes to $RUN/name.log, exit code to $RUN/name.rc
    local name=$1; shift
    (
        start=$SECONDS
        "$@" >"$RUN/$name.log" 2>&1 </dev/null
        rc=$?
        echo "$rc $((SECONDS - start))" >"$RUN/$name.rc"
        exit "$rc"
    ) &
    PIDS[$name]=$!
}

# upgrade = `nala upgrade --full` (the full upgrade apt_safety simulated; nala's default would hold back new
# kernels), or apt-get full-upgrade + autoremove without nala; upgrade-security = only the security updates.
# Both run only if the plan's hash still matches. Options and DEBIAN_FRONTEND are set by upall-root.
job_apt() { if ((SECURITY)); then sudo -n "$ROOT" upgrade-security "$APT_PLAN"; else sudo -n "$ROOT" upgrade "$APT_PLAN"; fi; }
job_flatpak() { LC_ALL=C.UTF-8 flatpak update -y --noninteractive; }
job_snap()    { sudo -n "$ROOT" snap-refresh; }

summary_line() {  # name -> one line from the log worth showing
    local log=$RUN/$1.log
    case $1 in
        apt)     grep -E -o '(Upgrade|Install|Auto-Remove|Remove) +[0-9]+ Packages?|Nothing to do|All packages are up to date|[0-9]+ upgraded, [0-9]+ newly installed, [0-9]+ to remove|no security updates|plan changed' "$log" | paste -sd',' ;;
        flatpak) grep -q 'Nothing to do' "$log" && echo 'nothing to do' || echo "updated: $(grep -c '^Updating' "$log")" ;;
        snap)    tail -n 3 "$log" | paste -sd'; ' ;;
    esac
}

wait_group() {  # report each job as it finishes; a spinner line names the ones still running
    local name rc t left=${#PIDS[@]} start=$SECONDS running
    ((TTY)) && { spin_reset; tput civis 2>/dev/null; }
    while ((left > 0)); do
        for name in "${!PIDS[@]}"; do
            [[ -f $RUN/$name.rc && -z ${RESULT[$name]:-} ]] || continue
            read -r rc t <"$RUN/$name.rc"; RESULT[$name]=$rc; left=$((left - 1))
            spin_clear
            if ((rc == 0)); then printf '%s✔ %-8s%s done in %s  %s%s%s\n' "$G" "$name" "$N" "$(fmt_t "$t")" "$D" "$(summary_line "$name")" "$N"
            else printf '%s✘ %-8s%s failed (exit %s) after %s. Last lines of %s:\n' "$R" "$name" "$N" "$rc" "$(fmt_t "$t")" "$RUN/$name.log"
                 tail -n 12 "$RUN/$name.log" | sed 's/^/    /'; fi
        done
        ((left > 0)) || break
        if ((TTY)); then
            running=()
            for name in "${!PIDS[@]}"; do [[ -f $RUN/$name.rc ]] || running+=("$name"); done
            spin_frame "running: ${running[*]}" "$start"; sleep 0.1
        else
            wait -n 2>/dev/null
        fi
    done
    spin_clear; ((TTY)) && tput cnorm 2>/dev/null
}

do_update() {
    local with_topgrade=$1 with_fw=$2 tui=$3 ask=$4
    RUN="$LOGROOT/$(date +%Y%m%d-%H%M%S)"; mkdir -p "$RUN"
    declare -gA PIDS=() RESULT=()

    # With upall-root installed and allowed in /etc/sudoers.d/upall-nopasswd, no password; otherwise ask once
    # and keep the ticket alive. (`sudo -l` can't tell: it also lists commands that need a password.)
    # An installed helper older than the one upall ships lacks actions upall uses: the shipped copy runs instead,
    # with your password (unattended runs stop there) until the new one is installed.
    local v_sys v_local
    v_sys=$("$ROOT_SYS" version 2>/dev/null) v_local=$("$ROOT_LOCAL" version 2>/dev/null)
    if [[ -n $v_sys && -n $v_local && $v_sys != "$v_local" ]]; then
        say "${Y}! $ROOT_SYS is version $v_sys, upall ships $v_local: run install.sh and the commands it prints${N}"
        ROOT=$ROOT_LOCAL
    fi
    if [[ $ROOT == "$ROOT_SYS" ]] && spin "Checking sudo" /dev/null sudo -n "$ROOT_SYS" ping; then
        say "${D}sudo: upall-root is passwordless${N}"
    else
        head_ "sudo"
        [[ -x $ROOT ]] || ROOT=$ROOT_LOCAL
        [[ -x $ROOT ]] || { say "${R}upall-root not found ($ROOT_SYS or $ROOT_LOCAL): run install.sh${N}"; exit 1; }
        sudo -v || { say "${R}sudo is needed for apt, snap and the snapshots.${N}"; exit 1; }
        ( while :; do sudo -n -v 2>/dev/null; sleep 50; done ) & SUDO_KEEPALIVE=$!
    fi
    export UPALL_ROOT=$ROOT    # the TUI uses the same helper

    if spin "Refreshing apt lists…" "$RUN/apt-update.log" sudo -n "$ROOT" update; then
        say "${G}✔${N} apt lists refreshed ${D}in $(fmt_t "$SPIN_T")${N}"
    else
        say "${R}✘ apt-get update failed:${N}"; grep -E '^(E|W):' "$RUN/apt-update.log" | sed 's/^/    /'
    fi

    if ((SECURITY)); then
        apt_safety "$ask"
        pre_apt_snapshot
        head_ "apt security updates ${D}(logs: $RUN)${N}"
        if ((APT_SKIP)); then :
        elif ((APT_WORK)); then run_job apt job_apt; wait_group
        else say "${G}✔${N} no security updates"; fi
        fw_and_summary none; return
    fi

    # If the upgrade includes snapd or flatpak themselves, don't update them while they're in use.
    local serial=()
    local upg; upg=$(LC_ALL=C apt list --upgradable 2>/dev/null | cut -d/ -f1)
    grep -qx snapd <<<"$upg" && serial+=(snap)
    grep -qxE 'flatpak|libflatpak0' <<<"$upg" && serial+=(flatpak)

    apt_safety "$ask"
    pre_apt_snapshot

    if [[ $tui == 1 ]]; then
        [[ $with_topgrade == 1 ]] && have topgrade && pre_tools_snapshot
        local targs=(--run "$RUN")
        [[ $with_topgrade == 1 ]] || targs+=(--no-tools)
        ((${#serial[@]})) && targs+=(--after-apt "$(IFS=,; echo "${serial[*]}")")
        ((APT_SKIP)) && targs+=(--skip-apt)
        UPALL_PLAN=$APT_PLAN python3 -I "$TUI" "${targs[@]}"; RESULT[tui]=$?
        fw_and_summary "$with_fw"; return
    fi

    head_ "apt + Flatpak + Snap in parallel ${D}(logs: $RUN)${N}"
    ((${#serial[@]})) && say "${Y}snapd/flatpak package itself is being upgraded: ${serial[*]} will run after apt.${N}"
    ((APT_SKIP)) || run_job apt job_apt
    have flatpak && [[ " ${serial[*]} " != *" flatpak "* ]] && run_job flatpak job_flatpak
    have snap && [[ " ${serial[*]} " != *" snap "* ]] && run_job snap job_snap
    say "${D}started: ${!PIDS[*]}${N}"
    ((${#PIDS[@]})) && wait_group
    if ((${#serial[@]})); then
        PIDS=()
        for s in "${serial[@]}"; do have "$s" && run_job "$s" "job_$s"; done
        wait_group
    fi

    if [[ $with_topgrade == 1 ]]; then
        head_ "topgrade (user-level tools, one after another)"
        if have topgrade; then
            pre_tools_snapshot
            topgrade --yes; RESULT[topgrade]=$?
        else
            say "${Y}topgrade not installed: uv tool install topgrade${N}"; RESULT[topgrade]=127
        fi
    fi
    fw_and_summary "$with_fw"
}

fw_and_summary() {
    local with_fw=$1
    if have fwupdmgr && [[ $with_fw != none ]]; then
        head_ "Firmware"
        if [[ $with_fw == 1 ]]; then fwupdmgr refresh >/dev/null 2>&1; fwupdmgr update; RESULT[firmware]=$?
        else
            local fw fwlog; fwlog=$(mktemp)
            spin "Checking firmware…" "$fwlog" check_firmware; fw=$(cat "$fwlog"); rm -f "$fwlog"
            if [[ -n $fw ]]; then say "$fw"; say "${Y}Apply with: upall --firmware${N}"
            else say "${G}✔${N} no firmware updates"; fi
        fi
    fi

    # Phone push for applied security updates: upall-secwatch reads dpkg.log (covers Discover too).
    pk_refresh

    head_ "Summary"
    local name bad=0
    ((APT_SKIP)) && printf '%s-%s apt skipped\n' "$Y" "$N"
    for name in apt flatpak snap topgrade tui firmware; do
        [[ -n ${RESULT[$name]:-} ]] || continue
        if ((RESULT[$name] == 0)); then printf '%s✔%s %s\n' "$G" "$N" "$name"
        else printf '%s✘%s %s (exit %s)\n' "$R" "$N" "$name" "${RESULT[$name]}"; bad=1; fi
    done
    ((${#RESULT[@]} || APT_SKIP)) || say "${G}✔${N} nothing to install"
    [[ -f /var/run/reboot-required ]] && say "${Y}Reboot required${N} ($(paste -sd' ' /var/run/reboot-required.pkgs 2>/dev/null))"
    return $bad
}

# ---------------------------------------------------------------- main
TUI="$HOME/.local/lib/upall/tui.py"
PK="$HOME/.local/lib/upall/pk_refresh.py"
topgrade_on=1 fw=0 mode=update tui=0 demo=0 ask=0
# Sourced (tests): load the functions only.
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0
for a in "$@"; do
    case $a in
        check|-c|--check) mode=check ;;
        --system|-s)      topgrade_on=0 ;;
        --firmware|-f)    fw=1 ;;
        --tui|-t)         tui=1 ;;
        --demo)           demo=1 ;;
        --ask|-a)         ask=1 ;;
        --security)       SECURITY=1 topgrade_on=0 ;;
        -h|--help|help)   usage; exit 0 ;;
        *) say "unknown option: $a"; usage; exit 2 ;;
    esac
done

case $mode in
    check)  do_check ;;
    update) if ((demo)); then exec python3 -I "$TUI" --demo; fi
            if ((SECURITY && tui)); then say "--security runs without the TUI (it is meant for unattended runs)"; exit 2; fi
            do_update "$topgrade_on" "$fw" "$tui" "$ask" ;;
esac
